{
  "name": "midas-nx",
  "version": "2.9.3",
  "description": "Unified TypeScript SDK for the MIDAS NX Open API (Civil NX + Gen NX) - employee-led open source",
  "license": "MIT",
  "author": {
    "name": "Dennis",
    "url": "https://www.linkedin.com/in/dennis58"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dennis5882/MIDAS-API-NX-SDK.git",
    "directory": "packages/typescript"
  },
  "homepage": "https://dennis5882.github.io/MIDAS-API-NX-SDK/",
  "bugs": {
    "url": "https://github.com/Dennis5882/MIDAS-API-NX-SDK/issues"
  },
  "keywords": [
    "midas",
    "midas-nx",
    "midas-gen",
    "midas-civil",
    "civil-nx",
    "gen-nx",
    "structural-engineering",
    "finite-element",
    "fea",
    "sdk",
    "typescript"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "generate": "python ../../scripts/generate_typescript_sdk.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "live:crud": "npm run build && node scripts/live-crud.mjs",
    "live:readonly": "npm run build && node scripts/live-readonly.mjs",
    "live:analysis": "npm run build && node scripts/live-analysis.mjs",
    "prepack": "npm run generate && npm run clean && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
